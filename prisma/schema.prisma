generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum ContentFormat {
  MARKDOWN
  RICHTEXT
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  studentId       String?
  role            Role          @default(USER)
  disabled        Boolean       @default(false)
  profileComplete Boolean       @default(false)
  createdAt       DateTime      @default(now())
  loginCodes       LoginCode[]
  solves           Solve[]
  activityLogs     ActivityLog[]
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]
  hintUnlocks      HintUnlock[]
  hostedInstances HostedInstance[]
  instanceEvents  InstanceEvent[]
  terminalSessions InstanceTerminalSession[]
}

model LoginCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  challenges Challenge[]
}

model Competition {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String            @default("")
  descriptionFormat ContentFormat     @default(MARKDOWN)
  startAt           DateTime
  endAt             DateTime
  hidden            Boolean           @default(false)
  status            CompetitionStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  challenges        Challenge[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
}

model Challenge {
  id                String        @id @default(cuid())
  competitionId     String
  categoryId        String
  title             String
  slug              String
  points            Int
  description       String        @default("")
  descriptionFormat ContentFormat @default(MARKDOWN)
  startAt           DateTime
  submitLimit       Int?
  hidden            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  competition       Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  category          Category      @relation(fields: [categoryId], references: [id])
  flags             Flag[]
  solves            Solve[]
  writeup           Writeup?
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  hints             Hint[]
  prerequisites     ChallengePrerequisite[] @relation("requires")
  requiredBy        ChallengePrerequisite[] @relation("requiredBy")
  hosted            Boolean       @default(false)
  hostingEnabled    Boolean       @default(false)
  hostingInternetEnabled Boolean  @default(false)
  hostingTemplate   Json?
  hostingVersion    Int           @default(0)
  hostedInstances   HostedInstance[]

  @@unique([competitionId, slug])
  @@index([competitionId])
  @@index([categoryId])
}

model Flag {
  id          String   @id @default(cuid())
  challengeId String
  flagHash    String
  value       String   @default("")
  label       String   @default("")
  order       Int      @default(0)
  retired     Boolean  @default(false)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solves      Solve[]

  @@index([challengeId])
}

model Hint {
  id            String        @id @default(cuid())
  challengeId   String
  title         String
  content       String        @default("")
  contentFormat ContentFormat @default(MARKDOWN)
  cost          Int           @default(0)
  order         Int           @default(0)
  retired       Boolean       @default(false)
  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  unlocks       HintUnlock[]

  @@index([challengeId])
}

model HintUnlock {
  id         String   @id @default(cuid())
  userId     String
  hintId     String
  costPaid   Int      @default(0)
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint       Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([userId, hintId])
  @@index([hintId])
}

model ChallengePrerequisite {
  challengeId         String
  requiredChallengeId String
  challenge           Challenge @relation("requires", fields: [challengeId], references: [id], onDelete: Cascade)
  requiredChallenge   Challenge @relation("requiredBy", fields: [requiredChallengeId], references: [id], onDelete: Restrict)

  @@id([challengeId, requiredChallengeId])
  @@index([requiredChallengeId])
}

model ChallengeBankEntry {
  id           String   @id @default(cuid())
  title        String
  categoryName String
  definition   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Solve {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  flagId      String
  ip          String
  pointsAwarded Int     @default(0)
  solvedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  flag        Flag      @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([userId, flagId])
  @@index([challengeId])
  @@index([userId])
  @@index([solvedAt])
}

model Writeup {
  id            String        @id @default(cuid())
  challengeId   String        @unique
  content       String        @default("")
  contentFormat ContentFormat @default(MARKDOWN)
  images        Json          @default("[]")
  updatedAt     DateTime      @updatedAt
  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model SitePage {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  content       String        @default("")
  contentFormat ContentFormat @default(RICHTEXT)
  isSystem      Boolean       @default(false)
  hidden        Boolean       @default(false)
  updatedAt     DateTime      @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  ip        String
  userAgent String   @default("")
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([ip])
  @@index([createdAt])
}

model SupportTicket {
  id            String              @id @default(cuid())
  userId        String
  subject       String
  status        SupportTicketStatus @default(OPEN)
  competitionId String?
  challengeId   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition   Competition?        @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  challenge     Challenge?          @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

model SupportMessage {
  id            String        @id @default(cuid())
  ticketId      String
  authorId      String
  body          String        @default("")
  competitionId String?
  challengeId   String?
  attachments   Json          @default("[]")
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  competition   Competition?  @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  challenge     Challenge?    @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
}

model HostingSettings {
  id                   String @id @default("default")
  maxInstances         Int    @default(500)
  memoryBudgetMb       Int    @default(4096)
  cpuBudgetMillicores   Int    @default(2000)
  publicHost           String @default("")
  portRangeStart       Int    @default(20000)
  portRangeEnd         Int    @default(29999)
  updatedAt            DateTime @updatedAt
}

model HostedInstance {
  id                    String   @id @default(cuid())
  userId                String
  challengeId           String
  state                 String   @default("QUEUED")
  desiredState          String   @default("RUNNING")
  generation            Int      @default(1)
  observedGeneration    Int      @default(0)
  template              Json
  templateVersion       Int
  internetEnabled       Boolean  @default(false)
  resourceMemoryMb      Int
  resourceCpuMillicores  Int
  endpoints             Json     @default("[]")
  containers            Json     @default("[]")
  expiresAt             DateTime
  operationToken        String?
  operationLeaseUntil   DateTime?
  lastError             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  challenge             Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  events                InstanceEvent[]
  terminalSessions      InstanceTerminalSession[]

  @@unique([userId, challengeId])
  @@index([desiredState, state])
  @@index([expiresAt])
}

model InstanceEvent {
  id          String   @id @default(cuid())
  instanceId  String?
  generation  Int?
  actorId     String?
  action      String
  level       String   @default("INFO")
  message     String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  instance    HostedInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([instanceId, createdAt])
  @@index([createdAt])
}

model RegistryCredential {
  id                String   @id @default(cuid())
  server            String   @unique
  username          String
  passwordEncrypted String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InstanceTerminalSession {
  id          String   @id @default(uuid())
  instanceId  String
  userId      String
  service     String
  generation  Int
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  instance    HostedInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
